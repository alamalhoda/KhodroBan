# ============================================
# Backend انتخاب Backend
# ============================================
# مقادیر: mock | supabase | django
# - mock: داده‌های تست بدون سرور
# - supabase: Backend روی Supabase (پیش‌فرض)
# - django: Backend روی Django (سرور خودتان)
VITE_BACKEND_TYPE=supabase

# آدرس API (بسته به Backend)
# برای Supabase: آدرس Rest API پروژه
# برای Django: آدرس سرور Django + /api (مثلاً http://127.0.0.1:8000/api)
VITE_API_URL=https://YOUR_PROJECT.supabase.co/rest/v1

# --- مثال برای استفاده از Django به‌جای Supabase ---
# VITE_BACKEND_TYPE=django
# VITE_API_URL=http://127.0.0.1:8000/api

# ============================================
# اپ و انتشار
# ============================================
VITE_APP_NAME=خودروبان
VITE_APP_VERSION=1.0.0
VITE_REDIRECT_BASE_URL=https://app.khodroban.top

# ============================================
# Supabase (فقط وقتی VITE_BACKEND_TYPE=supabase)
# ============================================
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ============================================
# AI (اختیاری)
# ============================================
# VITE_AI_PROVIDER=openrouter
# VITE_AI_API_KEY=your_openrouter_api_key
# VITE_OPENROUTER_API_URL=https://openrouter.ai/api/v1

# ============================================
# تلگرام (اختیاری)
# ============================================
# TELEGRAM_BOT_TOKEN=your_bot_token
# VITE_TELEGRAM_BOT_USERNAME=YourBot_username
# VITE_TELEGRAM_BOT_URL=https://your-backend/telegram-webhook
