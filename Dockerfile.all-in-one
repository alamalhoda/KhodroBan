# All-in-One: Frontend + Backend + SQLite در یک image
# بدون PostgreSQL و Redis؛ زمان‌بندی با crontab

# ─── Stage 1: Build Frontend ───────────────────────────────────────────────
FROM node:20-alpine AS frontend-builder

WORKDIR /app
COPY shared ./shared
COPY frontend-vue/package*.json ./frontend-vue/

WORKDIR /app/frontend-vue
RUN npm ci
COPY frontend-vue/ ./

ARG VITE_API_URL=/api
ARG VITE_BACKEND_TYPE=django
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_BACKEND_TYPE=$VITE_BACKEND_TYPE

RUN npm run build

# ─── Stage 2: Final Image ───────────────────────────────────────────────────
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libjpeg-dev zlib1g-dev \
    nginx \
    cron \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Backend
COPY backend/django/ ./backend/
RUN pip install --no-cache-dir -r backend/requirements.txt gunicorn

# Frontend (from stage 1)
COPY --from=frontend-builder /app/frontend-vue/dist /usr/share/nginx/html

# nginx config for all-in-one (proxy to localhost:8000)
COPY frontend-vue/nginx.all-in-one.conf /etc/nginx/conf.d/default.conf

# Crontab و entrypoint
COPY scripts/standalone-crontab /etc/cron.d/khodroban
RUN chmod 0644 /etc/cron.d/khodroban && crontab /etc/cron.d/khodroban

COPY scripts/standalone-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV DB_ENGINE=sqlite
ENV DISABLE_HUEY=true
ENV PYTHONUNBUFFERED=1

EXPOSE 80

VOLUME /app/backend/database
VOLUME /app/backend/media

ENTRYPOINT ["/entrypoint.sh"]
