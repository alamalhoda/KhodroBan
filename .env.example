# Database (DB_ENGINE=sqlite | postgresql)
DB_ENGINE=sqlite

# PostgreSQL (only when DB_ENGINE=postgresql)
POSTGRES_DB=khodroban_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis (required for Huey)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Django
DJANGO_SECRET_KEY=change-this-in-production
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend

# Optional
TELEGRAM_BOT_TOKEN=

# All-in-One: بدون Redis/Huey؛ از crontab استفاده می‌شود
# DISABLE_HUEY=true
